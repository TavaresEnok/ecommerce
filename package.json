{
  "name": "ecommerce-foundation", "version": "0.1.0", "private": true, "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "engines": {"node": ">=24.21.0 <25"}, "packageManager": "npm@11.6.2",
  "scripts": {
    "build": "npm run build -w @ecommerce/database && npm run build -w @ecommerce/media && npm run build -w @ecommerce/purchase && npm run build -w @ecommerce/api && npm run build -w @ecommerce/worker && npm run build -w @ecommerce/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "setup": "node scripts/setup.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "verify": "node scripts/verify.mjs --phase=1"
  },

  "dependencies": {"fastify": "5.12.5"},
  "devDependencies": {"@playwright/test": "1.63.0", "@types/node": "24.10.1", "@types/pg": "8.23.1", "typescript": "5.9.3"}
}
