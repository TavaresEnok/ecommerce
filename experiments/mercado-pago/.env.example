# Somente ambiente de TESTE do Mercado Pago. Nunca versionar valores reais.
MP_ENVIRONMENT=SANDBOX
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# HTTPS público (túnel) registrado na aplicação MP; caminho /oauth/callback
MP_REDIRECT_URI=https://SEU-TUNEL.example/oauth/callback
# Assinatura secreta de webhooks da aplicação (painel "Webhooks")
MP_WEBHOOK_SECRET=
# 64 caracteres hex (32 bytes) para cifrar tokens OAuth em repouso
POC_ENCRYPTION_KEY=
POC_OPERATOR=nome-do-responsavel
PORT=8787
