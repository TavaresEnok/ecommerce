# Copie somente como referência: npm run setup gera segredos locais aleatórios.
APP_ENV=development
NODE_ENV=development
LOCAL_MAILBOX=true
PUBLIC_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://api:3001
PORT=3001
DATABASE_URL=
AUTH_DATABASE_URL=
MIGRATION_DATABASE_URL=
REDIS_URL=redis://redis:6379
COOKIE_SECRET=
POSTGRES_PASSWORD=
MIGRATION_DB_PASSWORD=
APP_DB_PASSWORD=
AUTH_DB_PASSWORD=
# Segredo compartilhado borda (Caddy) → web → API para identificar o cliente no rate limit; obrigatório em produção.
EDGE_PROXY_SECRET=

# Fase 4: local registra e-mails como SIMULADOS (somente development/test); vazio = nenhum provedor, mensagens ficam pendentes.
MAIL_PROVIDER=local
