{
	# Store domains (seção 17.2, provedor CADDY_ON_DEMAND): a certificate is requested only after the API confirms the
	# hostname was proven by a store (PENDING_TLS/ACTIVE). Unknown hostnames are refused before any ACME request.
	on_demand_tls {
		ask http://api:3001/internal/tls/ask
	}
}
(security) {
	encode zstd gzip
	request_body {
		max_size 16KB
	}
	header {
		Referrer-Policy no-referrer
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Strict-Transport-Security "max-age=31536000"
	}
}
{$PLATFORM_HOST} {
	import security
	reverse_proxy web:3000
}
https:// {
	tls {
		on_demand
	}
	import security
	reverse_proxy web:3000
}
