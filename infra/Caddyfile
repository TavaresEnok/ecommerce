{
	# Store domains (seção 17.2, provedor CADDY_ON_DEMAND): a certificate is requested only after the API confirms the
	# hostname was proven by a store (PENDING_TLS/ACTIVE). Unknown hostnames are refused before any ACME request.
	on_demand_tls {
		ask http://api:3001/internal/tls/ask
	}
}
# Routing, body limits and client identity live in sites.caddy, shared verbatim with the local staging (Caddyfile.staging).
import /etc/caddy/sites.caddy
